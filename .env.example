# Google Programmable Search Engine credentials
# Create one at https://programmablesearchengine.google.com/ and get an API key
# from https://console.cloud.google.com/apis/credentials
GOOGLE_CSE_KEY=https://cse.google.com/cse.js?cx=c5c4a65e4152d41f5
GOOGLE_CSE_CX=gcse-search

# Optional: route all outbound HTTP through a proxy (e.g. http://user:pass@host:port)
